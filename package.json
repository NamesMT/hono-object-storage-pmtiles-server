{
  "name": "hono-object-storage-pmtiles-server",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.1",
  "description": "Hono PMTiles tile server backed by object storage (Tigris/aws-lite)",
  "author": "NamesMT <dangquoctrung123@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/namesmt",
  "homepage": "https://github.com/namesmt/hono-object-storage-pmtiles-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namesmt/hono-object-storage-pmtiles-server.git"
  },
  "bugs": "https://github.com/namesmt/hono-object-storage-pmtiles-server/issues",
  "keywords": [
    "hono",
    "pmtiles",
    "tile-server",
    "object-storage",
    "tigris",
    "aws-lite"
  ],
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "source": "./src/index.ts",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=dev tsx src/index.ts",
    "watch": "NODE_ENV=dev tsx watch src/index.ts",
    "dev": "pnpm run watch",
    "lint": "eslint .",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "check": "pnpm lint && pnpm test:types && vitest run --coverage",
    "build": "tsdown",
    "release": "pnpm dlx changelogen@latest --release --push --publish",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@aws-lite/client": "^0.22.4",
    "@aws-lite/s3": "^0.2.6",
    "@aws-lite/s3-types": "^0.2.6",
    "@namesmt/pmtiles-sources": "^0.1.1",
    "hono": "^4.6.5",
    "pmtiles": "^3.2.0",
    "srvx": "^0.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@namesmt/utils": "^0.5.6",
    "@types/node": "^20.16.11",
    "@vitest/coverage-v8": "^5.0.0",
    "consola": "^3.2.3",
    "eslint": "^9.12.0",
    "lint-staged": "^15.2.10",
    "simple-git-hooks": "^2.11.1",
    "std-env": "^3.7.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "is-core-module": "npm:@nolyfill/is-core-module@^1"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
