{
  "name": "hosps",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "description": "",
  "author": "NamesMT <dangquoctrung123@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/namesmt",
  "homepage": "https://github.com/namesmt/hosps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namesmt/hosps.git"
  },
  "bugs": "https://github.com/namesmt/hosps/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "source": "./src/index.ts",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.13.1"
  },
  "scripts": {
    "start": "NODE_ENV=dev tsx src/index.ts",
    "watch": "NODE_ENV=dev tsx watch src/index.ts",
    "stub": "unbuild --stub",
    "dev": "pnpm run watch",
    "play": "pnpm run stub && pnpm run --filter playground dev",
    "play:useBuild": "pnpm run build && pnpm run --filter playground dev",
    "lint": "eslint .",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "check": "pnpm lint && pnpm test:types && vitest run --coverage",
    "build": "unbuild",
    "release": "pnpm dlx changelogen@latest --release --push --publish",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@aws-lite/client": "^0.23.2",
    "@aws-lite/s3": "^0.2.6",
    "@aws-lite/s3-types": "^0.2.6",
    "hono": "^4.8.12",
    "pmtiles": "^3.2.1",
    "srvx": "^0.8.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@namesmt/pmtiles-sources": "^0.1.1",
    "@namesmt/utils": "^0.5.16",
    "@types/node": "^20.19.9",
    "@vitest/coverage-v8": "^2.1.9",
    "consola": "^3.4.2",
    "eslint": "^9.32.0",
    "lint-staged": "^15.5.2",
    "simple-git-hooks": "^2.13.1",
    "std-env": "^3.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "unbuild": "^2.0.0",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "is-core-module": "npm:@nolyfill/is-core-module@^1.0.39"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
